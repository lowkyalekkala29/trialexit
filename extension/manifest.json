{
  "manifest_version": 3,
  "name": "TrialExit",
  "version": "0.3.0",
  "description": "Track free trials and get a reminder that opens the exact cancel page — before you get charged.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TrialExit",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "src/dashboard.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.adobe.com/*",
        "https://*.anthropic.com/*",
        "https://*.audible.com/*",
        "https://*.audible.in/*",
        "https://*.canva.com/*",
        "https://*.chatgpt.com/*",
        "https://*.claude.ai/*",
        "https://*.disneyplus.com/*",
        "https://*.dropbox.com/*",
        "https://*.hotstar.com/*",
        "https://*.hulu.com/*",
        "https://*.jiohotstar.com/*",
        "https://*.linkedin.com/*",
        "https://*.music.youtube.com/*",
        "https://*.netflix.com/*",
        "https://*.one.google.com/*",
        "https://*.openai.com/*",
        "https://*.primevideo.com/*",
        "https://*.sonyliv.com/*",
        "https://*.spotify.com/*",
        "https://*.youtube.com/*",
        "https://*.zee5.com/*"
      ],
      "js": [
        "src/detect.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
